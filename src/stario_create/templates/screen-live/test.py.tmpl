from app.features.$screen.urls import $SCREEN, ${SCREEN}_ADD, ${SCREEN}_LIVE


async def test_${screen}_loads(client):
    r = await client.get($SCREEN.href())
    assert r.status_code == 200
    assert 'id="$screen"' in r.text


async def test_add_repaints_the_stream(client):
    headers = {"accept-encoding": "identity"}
    async with client.stream("GET", ${SCREEN}_LIVE.href(), headers=headers) as live:
        events = live.iter_events()
        first = await anext(events)
        assert 'id="$screen"' in first["data"]

        r = await client.post(${SCREEN}_ADD.href(), json={"body": "hello"})
        assert r.status_code == 204

        repaint = await anext(events)
        assert "hello" in repaint["data"]
