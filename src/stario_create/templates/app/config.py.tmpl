import os
from dataclasses import dataclass


@dataclass(frozen=True, slots=True)
class Config:
    app_name: str
    db_path: str

    @classmethod
    def from_env(cls) -> Config:
        return cls(
            app_name=os.environ.get("APP_NAME", "$app_name"),
            db_path=os.environ.get("APP_DB_PATH", "app.sqlite3"),
        )
